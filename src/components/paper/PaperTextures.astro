---
interface Props {
	mottleSeed?: number;
}

const { mottleSeed = 7 } = Astro.props;

const bakedMottles = [7, 11];
const mottle = bakedMottles.includes(mottleSeed)
	? `url('/tex/mottle-${mottleSeed}.webp')`
	: `url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22400%22 height=%22400%22><filter id=%22m%22 x=%220%22 y=%220%22 width=%22100%25%22 height=%22100%25%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.006%22 numOctaves=%223%22 seed=%22${mottleSeed}%22 stitchTiles=%22stitch%22/><feColorMatrix type=%22matrix%22 values=%220 0 0 0 0.42 0 0 0 0 0.31 0 0 0 0 0.15 0.8 0.8 0.8 0 -0.85%22/></filter><rect width=%22400%22 height=%22400%22 filter=%22url(%23m)%22/></svg>')`;
---

<div class="tex tex-dots" aria-hidden="true"></div>
<div class="tex tex-grain" aria-hidden="true"></div>
<div
	class="tex tex-mottle"
	style={`--mottle-img: ${mottle}`}
	aria-hidden="true">
</div>
<div class="tex tex-vignette" aria-hidden="true"></div>

<style>
	.tex {
		position: absolute;
		inset: 0;
		pointer-events: none;
		mix-blend-mode: multiply;
	}

	.tex-dots {
		z-index: 1;
		opacity: 0.22;
		background-image: url('/tex/dots.webp');
		background-size: 130px 130px;
	}

	.tex-grain {
		z-index: 1;
		opacity: 0.38;
		background-size: 150px 150px;
		background-image: url('/tex/grain.webp');
	}

	.tex-mottle {
		z-index: 1;
		opacity: 0.38;
		background-size: 1200px 1200px;
		background-image: var(--mottle-img);
	}

	.tex-vignette {
		z-index: 6;
		opacity: 0.64;
		background-image:
			linear-gradient(90deg, rgba(60, 42, 20, 0.24), transparent 7%),
			linear-gradient(-90deg, rgba(60, 42, 20, 0.24), transparent 7%),
			linear-gradient(180deg, rgba(60, 42, 20, 0.2), transparent 2.2%),
			linear-gradient(0deg, rgba(60, 42, 20, 0.2), transparent 2.2%);
	}

	@media (pointer: coarse) {
		.tex-grain,
		.tex-mottle {
			display: none;
		}

		.tex-dots,
		.tex-vignette {
			mix-blend-mode: normal;
		}
	}
</style>
