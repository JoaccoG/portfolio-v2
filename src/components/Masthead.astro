---
import { editionDate } from '../i18n/edition';
import { copyFor, localePath } from '../i18n/t';

const copy = copyFor(Astro.currentLocale);
const m = copy.masthead;
const other = Astro.currentLocale === 'es' ? 'en' : 'es';
const bare = Astro.url.pathname.replace(/^\/es(?=\/|$)/, '') || '/';
const switchHref = `${localePath(other, bare)}?lang=${other}`;
const date = editionDate(Astro.currentLocale);
const [folioPre = '', folioPost = ''] = m.folio[1].split('{date}');
---

<div class="top">
	<span class="mask"><span class="rise rise-1">{m.issueNo}</span></span>
	<span class="mask"><span class="rise rise-2 motto">{m.motto}</span></span>
	<span class="mask"><span class="rise rise-3">{m.price}</span></span>
</div>

<div class="plate-row">
	<div class="ear weather">
		<span class="ear-label">{m.weather.label}</span>
		<span class="weather-report">{m.weather.report}</span>
	</div>

	<h1 class="nameplate">
		<span class="fleuron fleuron-l" aria-hidden="true">✦</span>
		{
			m.nameplate.map((word, i) => (
				<span class:list={['word-mask', { gap: i < m.nameplate.length - 1 }]}>
					<span class:list={['word', `word-${i + 1}`]}>{word}</span>
				</span>
			))
		}
		<span class="fleuron fleuron-r" aria-hidden="true">✦</span>
	</h1>

	<div class="ear press">
		<span class="ear-label">{m.press.label}</span>
		<div class="seal-btn" aria-hidden="true">
			<svg viewBox="0 0 100 100" class="seal">
				<defs>
					<path id="sealtop" d="M 15,50 A 35,35 0 0 1 85,50"></path>
					<path id="sealbot" d="M 9.5,50 A 40.5,40.5 0 0 0 90.5,50"></path>
				</defs>
				<circle cx="50" cy="50" r="47.5" fill="var(--paper, #f2ead8)"
				></circle>
				<circle
					cx="50"
					cy="50"
					r="47.5"
					fill="none"
					stroke="var(--acc, #b4342a)"
					stroke-width="1.3"></circle>
				<circle
					cx="50"
					cy="50"
					r="26"
					fill="none"
					stroke="rgba(28,23,16,.4)"
					stroke-width=".8"></circle>
				<text text-anchor="middle" class="seal-arc">
					<textPath href="#sealtop" startOffset="50%">{m.press.sealTop}</textPath>
				</text>
				<text text-anchor="middle" class="seal-arc">
					<textPath href="#sealbot" startOffset="50%">{m.press.sealBottom}</textPath>
				</text>
				<text x="14" y="53.5" text-anchor="middle" class="seal-dot">·</text>
				<text x="86" y="53.5" text-anchor="middle" class="seal-dot">·</text>
				<text x="50" y="52" text-anchor="middle" class="seal-fleuron">❦</text>
				<text x="50" y="63" text-anchor="middle" class="seal-est">{m.press.sealEst}</text>
			</svg>
		</div>
	</div>
</div>

<div class="folio">
	<span class="folio-date"
		>{folioPre}<span
			data-live-date
			data-months={JSON.stringify(m.months)}
			data-template={m.dateTemplate}>{date}</span
		>{folioPost}</span
	>
	<span class="folio-place">{m.folio[0]}</span>
	<a
		class="folio-edition"
		href={switchHref}
		data-cur="1"
		data-edition-switch
		hreflang={other}
	>
		<span class="btn-hand" aria-hidden="true">☞</span>
		<span class="edition-label" lang={other}>{m.stamp.label}</span>
	</a>
</div>

<script>
	import { initLiveDate } from '../engine/livedate';

	initLiveDate();

</script>

<style>
	.top {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: baseline;
		font-size: clamp(0.58rem, 1vw, 0.7rem);
		letter-spacing: 0.2em;
	}

	.top > :last-child {
		justify-self: end;
	}

	.mask {
		display: block;
		overflow: hidden;
	}

	.rise {
		display: inline-block;
		transform: translateY(calc((1 - var(--mh, 1)) * 115%));
	}

	.rise-1 {
		transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1) 0s;
	}

	.rise-2 {
		transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1) 0.04s;
	}

	.rise-3 {
		transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1) 0.08s;
	}

	.motto {
		font-style: italic;
		letter-spacing: 0.1em;
	}

	.plate-row {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(1rem, 2.4vw, 2rem);
		padding: clamp(1rem, 2.6vw, 2rem) 0 clamp(0.7rem, 1.6vw, 1.2rem);
	}

	.ear {
		display: var(--ears, flex);
		flex-direction: column;
		max-width: 11rem;
		letter-spacing: 0.14em;
	}

	.weather {
		gap: 0.35rem;
		padding: 0.85rem 0;
		font-size: 0.74rem;
		opacity: calc(var(--mh, 1));
		transition: opacity 0.5s ease 0.2s;
	}

	.ear-label {
		font-weight: 700;
		font-size: 0.74rem;
		letter-spacing: 0.14em;
	}

	.weather-report {
		font-style: italic;
		letter-spacing: 0.04em;
		line-height: 1.5;
	}

	.nameplate {
		margin: 0 auto;
		position: relative;
		display: flex;
		align-items: baseline;
		white-space: nowrap;
		font-family: var(--fNP, 'Bodoni Moda'), 'Bodoni MT', Didot, serif;
		font-weight: 560;
		font-size: clamp(2.7rem, 8.6vw, 8rem);
		line-height: 1;
		letter-spacing: 0.005em;
	}

	.fleuron {
		align-self: center;
		color: var(--acc, #b4342a);
		font-size: 0.16em;
		line-height: 1;
		opacity: calc(var(--mh, 1));
	}

	.fleuron-l {
		margin-right: 0.3em;
		transition: opacity 0.5s ease 0.16s;
	}

	.fleuron-r {
		margin-left: 0.3em;
		transition: opacity 0.5s ease 0.2s;
	}

	.word-mask {
		display: block;
		overflow: hidden;
		padding-bottom: 0.06em;
	}

	.word-mask.gap {
		margin-right: 0.22em;
	}

	.word {
		display: inline-block;
		transform: translateY(calc((1 - var(--mh, 1)) * 112%));
	}

	.word-1 {
		transition: transform 0.7s cubic-bezier(0.19, 1, 0.22, 1) 0s;
	}

	.word-2 {
		transition: transform 0.7s cubic-bezier(0.19, 1, 0.22, 1) 0.06s;
	}

	.word-3 {
		transition: transform 0.7s cubic-bezier(0.19, 1, 0.22, 1) 0.12s;
	}




	.press {
		align-items: center;
		gap: 0.45rem;
		padding: 0.6rem 0;
		font-size: 0.6rem;
		text-align: center;
		opacity: calc(var(--mh, 1));
		transition: opacity 0.5s ease 0.22s;
	}

	.seal-btn {
		width: clamp(64px, 6.4vw, 92px);
		border: none;
		padding: 0;
		cursor: inherit;
	}

	.seal {
		width: 100%;
		display: block;
	}

	.seal-arc {
		font-family: var(--fBD, 'Old Standard TT'), serif;
		font-size: 8.4px;
		letter-spacing: 0.16em;
		fill: var(--acc, #b4342a);
	}

	.seal-dot {
		font-family: Georgia, serif;
		font-size: 7px;
		fill: var(--acc, #b4342a);
	}

	.seal-fleuron {
		font-family: 'TDG Ornaments', Georgia, serif;
		font-size: 16.5px;
		fill: var(--acc, #b4342a);
	}

	.seal-est {
		font-family: var(--fBD, 'Old Standard TT'), serif;
		font-size: 5.6px;
		letter-spacing: 0.14em;
		fill: var(--acc, #b4342a);
	}

	.folio {
		position: relative;
		border-top: 3px double rgba(28, 23, 16, 0.75);
		border-bottom: 3px double rgba(28, 23, 16, 0.75);
		padding: 0.4rem clamp(0.4rem, 1.5vw, 1rem);
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		grid-template-areas: "date place edition";
		align-items: center;
		column-gap: 1.2rem;
		font-size: clamp(0.6rem, 1.1vw, 0.72rem);
		letter-spacing: 0.2em;
		white-space: nowrap;
		opacity: calc(var(--mh, 1));
		transition: opacity 0.5s ease 0.18s;
	}

	.folio-date {
		grid-area: date;
		justify-self: start;
	}

	.folio-place {
		grid-area: place;
		justify-self: center;
	}

	.folio-edition {
		grid-area: edition;
		justify-self: end;
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		padding: 0.45rem 0;
		color: var(--acc, #b4342a);
		text-decoration: none;
		cursor: inherit;
	}

	.edition-label {
		border-bottom: 1px dotted currentColor;
		padding-bottom: 0.1em;
	}

	.folio-edition:hover .edition-label {
		border-bottom-style: solid;
	}

	.folio-edition[aria-busy="true"] {
		opacity: 0.55;
	}

	.btn-hand {
		letter-spacing: 0;
		font-size: 1.1em;
	}

	@media (max-width: 1199.98px) {
		.folio {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-areas:
				"place place"
				"date edition";
			row-gap: 0.1rem;
		}
	}

	@media (max-width: 599.98px) {
		.folio {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				"place"
				"date"
				"edition";
			justify-items: center;
			row-gap: 0.25rem;
			padding-top: 0.6rem;
			text-align: center;
			white-space: normal;
		}

		.folio-date {
			justify-self: center;
			text-wrap: balance;
		}

		.folio-edition {
			justify-self: center;
			min-height: 44px;
			padding: 0 0.6rem;
		}
	}
	@media print {
		.folio {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				"place"
				"date";
			justify-items: center;
		}

		.folio-date {
			justify-self: center;
		}
	}
</style>
