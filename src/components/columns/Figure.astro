---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { copy } from '../../i18n/t';

interface Props {
	src?: ImageMetadata;
	alt?: string;
	caption: string;
	credit: string;
	kind?: 'engraving' | 'photograph';
}

const { src, alt, caption, credit, kind = 'engraving' } = Astro.props;
const f = copy.columns.figure;
const chip = kind === 'photograph' ? f.photograph : f.engraving;
const widths = [560, 800, 1060, 1280];
const sizes = '(max-width: 767.98px) 92vw, 40rem';
---

<figure class="figure">
	{
		src ? (
			<button
				type="button"
				class="frame plate-btn"
				data-plate-open
				data-cur="1"
				aria-label={f.expand.replace('{caption}', caption)}
			>
				<Image
					class="plate"
					src={src}
					alt={alt ?? caption}
					widths={widths}
					sizes={sizes}
				/>
			</button>
		) : (
			<div class="frame">
				<span class="chip">{chip}</span>
			</div>
		)
	}
	<figcaption>
		<span class="cap">{caption}</span>
		<span class="credit">{credit}</span>
	</figcaption>
</figure>

<style>
	.figure {
		margin: 1.8rem 0;
	}

	.frame {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		border: 1px solid rgba(28, 23, 16, 0.55);
		box-shadow:
			inset 0 0 0 3px var(--paper, #f2ead8),
			inset 0 0 0 4px rgba(28, 23, 16, 0.5);
		background-color: var(--paper-plate, #e4d8be);
		background-image: radial-gradient(
			rgba(28, 23, 16, 0.45) 1px,
			transparent 1.15px
		);
		background-size: 5px 5px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.plate-btn {
		padding: 0;
		cursor: inherit;
	}

	.plate {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: sepia(0.08) contrast(1.02);
	}

	.chip {
		border: 1px solid rgba(28, 23, 16, 0.5);
		background: var(--paper, #f2ead8);
		padding: 0.35rem 0.75rem;
		font-size: 0.54rem;
		letter-spacing: 0.2em;
		text-align: center;
	}

	figcaption {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		padding-top: 0.5rem;
		font-size: 0.58rem;
		letter-spacing: 0.14em;
		opacity: 0.72;
	}

	.cap {
		font-style: italic;
		letter-spacing: 0.04em;
	}
</style>
