---
import { copy } from '../../i18n/t';

const line = copy.columns.footer;
const credit = copy.finale.colophon[copy.finale.colophon.length - 1] ?? '';
const creditText = credit.replace(/^©\s*/, '');
---

<p class="colophon">
	<span class="colophon-main">{line}</span>
	<span class="colophon-credit"
		><span class="acc">©</span> {creditText} <span class="acc">❦</span></span
	>
</p>

<style>
	.colophon {
		margin: clamp(1.8rem, 4vw, 3rem) 0 0;
		text-align: center;
		font-size: 0.58rem;
		letter-spacing: 0.24em;
		border-top: 3px double rgba(28, 23, 16, 0.7);
		padding-top: 0.9rem;
	}

	.colophon-main,
	.colophon-credit {
		display: block;
	}

	.colophon-credit {
		margin-top: 0.55rem;
	}

	.acc {
		color: var(--acc, #b4342a);
	}
</style>
