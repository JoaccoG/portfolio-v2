---
import { copy } from '../i18n/t';

const c = copy.cvAd;
---

<section>
	<div class="card" data-rv="1">
		<p class="kicker">{c.kicker}</p>
		<p class="title">{c.title}<span class="acc">!</span></p>
		<p class="dek">{c.dek}</p>
		<div class="links">
			{
				c.links.map((link) => (
					<a href={link.href} data-cur="1" target="_blank" rel="noreferrer">
						<span class="acc">☞</span>
						{` ${link.label}`}
					</a>
				))
			}
		</div>
		<p class="footer">{c.footer}</p>
	</div>
</section>

<style>
	section {
		padding: clamp(2rem, 5vw, 3.4rem) 0 0;
		border-top: 1px solid rgba(28, 23, 16, 0.45);
		margin-top: -1px;
	}

	.card {
		border: 3px double rgba(28, 23, 16, 0.6);
		padding: clamp(1.4rem, 3.4vw, 2.4rem);
		text-align: center;
		background-color: var(--paper, #f2ead8);
		background-image: repeating-linear-gradient(
			0deg,
			transparent 0 6px,
			rgba(28, 23, 16, 0.02) 6px 7px
		);
		transform: rotate(-0.5deg) translateY(calc((1 - var(--rv, 1)) * 26px));
		opacity: var(--rv, 1);
		transition:
			opacity 0.9s ease,
			transform 0.9s cubic-bezier(0.19, 1, 0.22, 1);
	}

	.kicker {
		margin: 0 0 0.3rem;
		font-size: 0.6rem;
		letter-spacing: 0.34em;
	}

	.title {
		margin: 0 0 0.4rem;
		font-family: var(--fHD, 'Bodoni Moda'), Didot, serif;
		font-weight: 680;
		font-size: clamp(1.8rem, 5vw, 3.6rem);
		line-height: 1.05;
	}

	.acc {
		color: var(--acc, #b4342a);
	}

	.dek {
		margin: 0 auto 0.9rem;
		font-style: italic;
		font-size: clamp(0.9rem, 1.6vw, 1.05rem);
		max-width: 40rem;
	}

	.links {
		display: flex;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	a {
		border: 1px solid var(--ink, #1c1710);
		padding: 0.8rem 1.6rem;
		font-size: 0.7rem;
		letter-spacing: 0.24em;
		transition:
			background 0.25s ease,
			color 0.25s ease;
	}

	a:hover {
		background: var(--ink, #1c1710);
		color: var(--paper, #f2ead8);
	}

	.footer {
		margin: 0.9rem 0 0;
		font-size: 0.56rem;
		letter-spacing: 0.2em;
		color: var(--acc, #b4342a);
	}
</style>
