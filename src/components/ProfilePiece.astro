---
import { copy } from '../i18n/t';
import RunningHead from './RunningHead.astro';

const p = copy.profile;
const r = copy.sections.profile;
const numerals = ['I', 'II', 'III', 'IV'];
---

<section id="profile" data-sec="profile" data-goto="profile">
	<div class="board" data-board>
		<RunningHead
			section={r.section}
			name={r.name}
			tagline={r.tagline}
			page={r.page}
			flush
		/>
		<div class="stage">
			<div class="head">
				<p class="head-kicker">{p.kicker}</p>
				<h2 class="head-title">{p.title}</h2>
			</div>
			<div class="ghosts" aria-hidden="true">
				{numerals.map((n, i) => <span class:list={['ghost', `ghost-${i}`]}>{n}</span>)}
			</div>
			<div class="text-block">
				{
					p.parts.map((part, i) => (
						<article class:list={[`part-${i}`]}>
							<p class="part-kicker">{part.kicker}</p>
							<h3>{part.title}</h3>
							<p class="part-body">{part.body}</p>
							{'tight' in part && <p class="part-tight">{part.tight}</p>}
							<p class="part-footer">{part.footer}</p>
						</article>
					))
				}
			</div>
			<div class="ticks" aria-hidden="true">
				{numerals.map((_, i) => <span class:list={['tick', `tick-${i}`]} />)}
			</div>
		</div>
	</div>
</section>

<style>
	section {
		height: 380vh;
		position: relative;
		margin: 0
			calc(var(--pad-x, clamp(1rem, 3.6vw, 3.6rem)) * -1) 0;
	}

	.board {
		display: flex;
		flex-direction: column;
		height: 100vh;
		overflow: hidden;
		transform: translateY(calc(var(--pin, 0) * 1px));
		will-change: transform;
	}

	.stage {
		position: relative;
		flex: 1;
		min-height: 0;
	}

	.head {
		position: absolute;
		top: clamp(1rem, 3vh, 2rem);
		left: 0;
		right: 0;
		text-align: center;
	}

	.head-kicker {
		margin: 0 0 0.3rem;
		font-size: 0.64rem;
		letter-spacing: 0.3em;
		color: var(--acc, #b4342a);
		font-weight: 700;
	}

	.head-title {
		margin: 0;
		font-family: var(--fHD, 'Bodoni Moda'), Didot, serif;
		font-style: italic;
		font-size: clamp(1.1rem, 2.2vw, 1.6rem);
	}

	.ghosts {
		position: absolute;
		left: clamp(-1rem, 1vw, 3rem);
		top: 50%;
		transform: translateY(-50%) rotate(-4deg);
		font-family: var(--fHD, 'Bodoni Moda'), Didot, serif;
		font-style: italic;
		font-weight: 400;
		font-size: clamp(13rem, 33vw, 28rem);
		line-height: 1;
		user-select: none;
	}

	.ghost {
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
	}

	.ghost-0 {
		opacity: calc(var(--pc0, 1) * 0.13);
	}

	.ghost-1 {
		opacity: calc(var(--pc1, 0) * 0.13);
	}

	.ghost-2 {
		opacity: calc(var(--pc2, 0) * 0.13);
	}

	.ghost-3 {
		opacity: calc(var(--pc3, 0) * 0.13);
	}

	.text-block {
		position: absolute;
		left: var(--pbl, 40%);
		right: clamp(1.2rem, 6vw, 7rem);
		top: 50%;
		height: 0;
	}

	article {
		position: absolute;
		inset: auto 0 auto 0;
	}

	.part-0 {
		transform: translateY(-50%) translateY(calc((1 - var(--pc0, 1)) * 34px));
		opacity: var(--pc0, 1);
	}

	.part-1 {
		transform: translateY(-50%) translateY(calc((1 - var(--pc1, 0)) * 34px));
		opacity: var(--pc1, 0);
	}

	.part-2 {
		transform: translateY(-50%) translateY(calc((1 - var(--pc2, 0)) * 34px));
		opacity: var(--pc2, 0);
	}

	.part-3 {
		transform: translateY(-50%) translateY(calc((1 - var(--pc3, 0)) * 34px));
		opacity: var(--pc3, 0);
	}

	.part-kicker {
		margin: 0 0 0.8rem;
		font-size: 0.66rem;
		letter-spacing: 0.3em;
		color: var(--acc, #b4342a);
		font-weight: 700;
	}

	h3 {
		margin: 0 0 1.1rem;
		font-family: var(--fHD, 'Bodoni Moda'), Didot, serif;
		font-weight: 600;
		font-size: clamp(2rem, 4.6vw, 3.6rem);
		line-height: 1;
	}

	.part-body,
	.part-tight {
		font-size: clamp(0.95rem, 1.5vw, 1.08rem);
		line-height: 1.7;
		text-align: justify;
		hyphens: manual;
		max-width: 34rem;
	}

	.part-body {
		margin: 0 0 1rem;
	}

	.part-tight {
		margin: -1rem 0 1rem;
	}

	.part-footer {
		margin: 0;
		font-size: 0.62rem;
		letter-spacing: 0.2em;
		font-style: italic;
		opacity: 0.65;
	}

	.ticks {
		position: absolute;
		bottom: clamp(4.4rem, 9vh, 6rem);
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 10px;
	}

	.tick {
		width: 26px;
		height: 2px;
		transition: background 0.4s ease;
	}

	.tick-0 {
		background: var(--ptk0, var(--acc, #b4342a));
	}

	.tick-1 {
		background: var(--ptk1, rgba(28, 23, 16, 0.25));
	}

	.tick-2 {
		background: var(--ptk2, rgba(28, 23, 16, 0.25));
	}

	.tick-3 {
		background: var(--ptk3, rgba(28, 23, 16, 0.25));
	}

	@media (max-width: 1019.98px) {
		.ghosts {
			left: 50%;
		}

		.ghost {
			transform: translateY(-50%) translateX(-50%);
		}
	}

	@media (pointer: coarse) {
		section {
			height: 380svh;
		}

		.board {
			position: sticky;
			top: 0;
			height: 100svh;
			transform: none;
			will-change: auto;
		}
	}
</style>
