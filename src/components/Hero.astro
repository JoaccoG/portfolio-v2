---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.webp';
import portraitMoustache from '../assets/portrait-moustache.webp';
import { copy } from '../i18n/t';

const h = copy.hero;
const [p1, ...rest] = h.paragraphs;
const dropCap = p1.charAt(0);
const p1Rest = p1.slice(1);
const portraitWidths = [420, 640, 920, 1254];
const portraitSizes =
	'(max-width: 1019px) 420px, (max-width: 1560px) 30vw, 460px';
---

<div class="grid">
	<div>
		<p class="kicker-mask">
			<span class="kicker">{h.kicker}</span>
		</p>
		<h2 class="headline">
			<span class="line-mask lm-1"><span class="line line-1">{h.headline[0]}</span></span>
			<span class="line-mask lm-2">
				<span class="line line-2">{h.headline[1]}<span class="acc">.</span></span>
			</span>
		</h2>
		<div class="lead-body">
			<p class="dek">{h.dek}</p>
			<p class="byline">{h.byline}</p>
			<div class="columns">
				<p class="para">
					<span class="drop-cap">{dropCap}</span>{p1Rest}
				</p>
				{rest.slice(0, -1).map((para) => <p class="para">{para}</p>)}
				<p class="para-last">{rest[rest.length - 1]}</p>
				<p class="closer">
					{h.closer}<span class="closer-sig">{h.closerSignature}</span>
				</p>
			</div>
		</div>
	</div>
	<aside>
		<span class="divider" aria-hidden="true"></span>
		<figure>
			<div class="clip">
				<div class="frame">
					<div class="pwrap" data-cur="1" data-portrait>
						<Image
							src={portrait}
							alt={h.portrait.alt}
							widths={portraitWidths}
							sizes={portraitSizes}
							quality={78}
							loading="eager"
							fetchpriority="high"
							class="pimg"
						/>
						<Image
							src={portraitMoustache}
							alt=""
							aria-hidden="true"
							widths={portraitWidths}
							sizes={portraitSizes}
							quality={78}
							loading="lazy"
							class="pimg pimg-mo"
						/>
					</div>
				</div>
			</div>
			<figcaption>
				{h.portrait.caption}<span class="cap-it">{h.portrait.captionItalic}</span>
			</figcaption>
		</figure>
		<div class="card card-index">
			<p class="card-title">{h.inThisEdition.title}</p>
			<div class="index-rows">
				{
					h.inThisEdition.rows.map((row) => (
						<button type="button" data-cur="1" data-target={row.target} class="index-row">
							<span class="index-label">{row.label}</span>
							<span>☞</span>
						</button>
					))
				}
			</div>
		</div>
		<div class="card card-almanac">
			<p class="card-title title-almanac">{h.almanac.title}</p>
			{
				h.almanac.rows.map((row) => (
					<div class="alm-row">
						<span class="alm-label">{row.label}</span>
						<span class="alm-value">{row.value}</span>
					</div>
				))
			}
			<p class="alm-footer">{h.almanac.footer}</p>
		</div>
		<div class="card card-notices">
			<p class="card-title title-notices">{h.notices.title}</p>
			{
				h.notices.items.map((item, i) => (
					<p class:list={['notice', { 'notice-last': i === h.notices.items.length - 1 }]}>
						<span class="notice-lead">{item.lead}</span> {item.body}
					</p>
				))
			}
		</div>
	</aside>
</div>
<div class="cue" data-cue aria-hidden="true">
	<span class="cue-label">{h.cue}</span>
	<span class="cue-arrow">▼</span>
</div>

<style>
	.grid {
		display: grid;
		grid-template-columns: var(--gLead, 2.15fr 1fr);
		gap: clamp(1.4rem, 3vw, 2.8rem);
		padding-top: clamp(1.4rem, 3vw, 2.4rem);
	}

	@media (max-width: 1019.98px) {
		.grid {
			display: flex;
			flex-direction: column;
			gap: 1.3rem;
		}

		.grid > div,
		.grid > aside {
			display: contents;
		}

		.kicker-mask {
			order: 1;
			margin-bottom: 0;
		}

		.headline {
			order: 2;
			margin-bottom: 0;
		}

		figure {
			order: 3;
		}

		.lead-body {
			order: 4;
		}

		.card-index {
			order: 5;
		}

		.card-almanac {
			order: 6;
		}

		.card-notices {
			order: 7;
		}
	}

	.kicker-mask {
		margin: 0 0 0.8rem;
		overflow: hidden;
	}

	.kicker {
		display: inline-block;
		font-size: 0.68rem;
		letter-spacing: 0.3em;
		color: var(--acc, #b4342a);
		font-weight: 700;
		transform: translateY(calc((1 - var(--mh, 1)) * 130%));
		transition: transform 0.8s cubic-bezier(0.19, 1, 0.22, 1) 0.5s;
	}

	.headline {
		margin: 0 0 1.2rem;
		font-family: var(--fHD, 'Bodoni Moda'), Didot, serif;
		font-weight: 620;
		font-size: clamp(2.5rem, 8.6vw, 8.2rem);
		line-height: 0.95;
		letter-spacing: 0.002em;
		text-transform: uppercase;
	}

	.line-mask {
		display: block;
		overflow: hidden;
	}

	.lm-1 {
		padding-bottom: 0.04em;
	}

	.lm-2 {
		padding-bottom: 0.06em;
	}

	.line {
		display: inline-block;
		transform: translateY(calc((1 - var(--mh, 1)) * 110%));
	}

	.line-1 {
		transition: transform 1s cubic-bezier(0.19, 1, 0.22, 1) 0.55s;
	}

	.line-2 {
		transition: transform 1s cubic-bezier(0.19, 1, 0.22, 1) 0.67s;
	}

	.acc {
		color: var(--acc, #b4342a);
	}

	.lead-body {
		opacity: calc(var(--mh, 1));
		transform: translateY(calc((1 - var(--mh, 1)) * 24px));
		transition:
			opacity 0.9s ease 0.85s,
			transform 0.9s cubic-bezier(0.19, 1, 0.22, 1) 0.85s;
	}

	.dek {
		margin: 0 0 1.1rem;
		font-style: italic;
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		line-height: 1.5;
		color: var(--ink-soft, #3a3222);
		max-width: 46rem;
		text-wrap: pretty;
	}

	.byline {
		margin: 0 0 1.3rem;
		font-size: 0.66rem;
		letter-spacing: 0.22em;
		border-top: 1px solid rgba(28, 23, 16, 0.4);
		border-bottom: 1px solid rgba(28, 23, 16, 0.4);
		padding: 0.4rem 0;
		max-width: 46rem;
	}

	.columns {
		columns: var(--leadCols, 2);
		column-gap: 2.2rem;
		column-rule: 1px solid rgba(28, 23, 16, 0.2);
		font-size: 0.96rem;
		line-height: 1.62;
		text-align: justify;
		hyphens: manual;
		max-width: 46rem;
	}

	.para {
		margin: 0 0 0.9rem;
	}

	.para-last {
		margin: 0;
	}

	.closer {
		margin: 0.9rem 0 0;
	}

	.closer-sig {
		letter-spacing: 0.12em;
	}

	.drop-cap {
		float: left;
		font-family: var(--fHD, 'Bodoni Moda'), Didot, serif;
		font-size: 3.4em;
		line-height: 0.76;
		padding: 0.05em 0.12em 0 0;
		font-weight: 600;
	}

	aside {
		display: flex;
		flex-direction: column;
		gap: 1.3rem;
		position: relative;
		padding-left: var(--colPad, clamp(1.2rem, 2.4vw, 2.2rem));
	}

	.divider {
		display: var(--colD, block);
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 1px;
		background: rgba(28, 23, 16, 0.25);
		transform: scaleY(var(--mh, 1));
		transform-origin: 50% 0;
		transition: transform 1.3s cubic-bezier(0.19, 1, 0.22, 1) 0.75s;
	}

	figure {
		margin: 0 auto;
		max-width: var(--portMax, none);
		width: 100%;
		transform: translateY(calc(var(--hp, 0) * -18px));
	}

	.clip {
		clip-path: inset(calc((1 - var(--mh, 1)) * 100%) 0 0 0);
		transition: clip-path 1.2s cubic-bezier(0.19, 1, 0.22, 1) 0.7s;
	}

	.frame {
		aspect-ratio: 1 / 1;
		border: 1px solid rgba(28, 23, 16, 0.55);
		box-shadow:
			inset 0 0 0 3px var(--paper, #f2ead8),
			inset 0 0 0 4px rgba(28, 23, 16, 0.55);
		overflow: hidden;
	}

	.pwrap {
		width: 100%;
		height: 100%;
		position: relative;
	}

	@media (hover: hover) {
		.pwrap:hover {
			--mo: 1;
		}
	}

	@media (pointer: coarse) {
		.pwrap {
			cursor: pointer;
		}
	}

	.pimg {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: sepia(0.08) contrast(1.02);
	}

	.pimg-mo {
		position: absolute;
		inset: 0;
		opacity: var(--mo, 0);
		transition: opacity 0.3s ease;
	}

	figcaption {
		text-align: center;
		font-size: 0.66rem;
		letter-spacing: 0.16em;
		padding-top: 0.5rem;
		opacity: calc(var(--mh, 1));
		transform: translateY(calc((1 - var(--mh, 1)) * 14px));
		transition:
			opacity 0.8s ease 0.95s,
			transform 0.8s cubic-bezier(0.19, 1, 0.22, 1) 0.95s;
	}

	.cap-it {
		font-style: italic;
		letter-spacing: 0.04em;
	}

	.card {
		border: 3px double rgba(28, 23, 16, 0.6);
		padding: 0.9rem 1rem;
		background: var(--paper, #f2ead8);
		opacity: calc(var(--mh, 1));
	}

	.card-index {
		transition: opacity 0.9s ease 1s;
	}

	.card-almanac {
		container-type: inline-size;
		padding: 0.9rem 1rem 0.85rem;
		transition: opacity 0.9s ease 1.12s;
	}

	.card-notices {
		transition: opacity 0.9s ease 1.24s;
	}

	.card-title {
		margin: 0 0 0.35rem;
		text-align: center;
		font-size: 0.66rem;
		letter-spacing: 0.28em;
		font-weight: 700;
		border-bottom: 3px double rgba(28, 23, 16, 0.65);
		padding-bottom: 0.5rem;
	}

	.title-almanac {
		margin: 0 0 0.6rem;
	}

	.title-notices {
		margin: 0 0 0.65rem;
	}

	.index-rows {
		display: flex;
		flex-direction: column;
	}

	.index-row {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.5rem 0.2rem;
		background: none;
		border: none;
		font-size: 0.82rem;
		cursor: inherit;
		text-align: left;
		transition: transform 0.3s ease;
	}

	.index-row:hover {
		color: var(--acc, #b4342a);
		transform: translateX(5px);
	}

	.index-row + .index-row {
		border-top: 1px dotted rgba(28, 23, 16, 0.45);
	}

	.index-label {
		font-style: italic;
	}

	.alm-row {
		display: grid;
		grid-template-columns: auto 1fr;
		column-gap: 0.9em;
		row-gap: 0.15rem;
		align-items: baseline;
		font-size: 0.58rem;
		letter-spacing: 0.14em;
		padding: 0.4rem 0;
		border-bottom: 1px dotted rgba(28, 23, 16, 0.28);
	}

	.alm-row:last-of-type {
		border-bottom: none;
	}

	.alm-value {
		font-weight: 700;
		text-align: right;
		color: var(--acc, #b4342a);
	}

	@container (max-width: 360px) {
		.alm-row {
			grid-template-columns: 1fr;
		}

		.alm-value {
			text-align: left;
		}
	}

	.alm-footer {
		margin: 0.6rem 0 0;
		text-align: center;
		font-size: 0.72rem;
		font-style: italic;
	}

	.notice {
		margin: 0 0 0.65rem;
		font-size: 0.82rem;
		font-style: italic;
		line-height: 1.55;
	}

	.notice-last {
		margin: 0;
	}

	.notice-lead {
		font-style: normal;
		font-size: 0.58rem;
		letter-spacing: 0.18em;
		font-weight: 700;
		color: var(--acc, #b4342a);
	}

	.cue {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		padding: clamp(1.4rem, 3vw, 2.2rem) 0 0.4rem;
		opacity: calc(var(--cue, 1) * var(--mh, 1));
		transition: opacity 0.6s ease;
	}

	.cue-label {
		font-size: 0.6rem;
		letter-spacing: 0.34em;
	}

	.cue-arrow {
		color: var(--acc, #b4342a);
		font-size: 0.8rem;
	}
</style>
