---
import { copyFor } from '../../i18n/t';
import Base from '../../layouts/Base.astro';
import Appointments from '../Appointments.astro';
import Classifieds from '../Classifieds.astro';
import Columns from '../Columns.astro';
import CustomCursor from '../CustomCursor.astro';
import CvAd from '../CvAd.astro';
import Finale from '../Finale.astro';
import Hero from '../Hero.astro';
import Masthead from '../Masthead.astro';
import PageTwo from '../PageTwo.astro';
import Plates from '../Plates.astro';
import Postcard from '../Postcard.astro';
import Preloader from '../Preloader.astro';
import ProfilePiece from '../ProfilePiece.astro';
import Sheet from '../paper/Sheet.astro';
import RunningHead from '../RunningHead.astro';
import Ticker from '../Ticker.astro';

const copy = copyFor(Astro.currentLocale);
const sec = copy.sections;
---

<Base>
	<script is:inline>
		(() => {
			const doc = document.documentElement;
			let seen = false;
			try {
				seen = sessionStorage.getItem('hasSeenIntro') === '1';
			} catch (e) {
				seen = false;
			}
			if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			doc.dataset.intro = 'play';
			const style = doc.style;
			style.setProperty('--preO', '1');
			style.setProperty('--prePE', 'auto');
			style.setProperty('--intro', '0');
			style.setProperty('--mh', '0');
			style.overflow = 'hidden';
			try {
				sessionStorage.setItem('hasSeenIntro', '1');
			} catch (e) {}
		})();
	</script>
	<span class="progress" data-progress aria-hidden="true"></span>
	<Preloader />
	<CustomCursor />
	<main id="main-content">
		<Sheet>
			<Ticker />
			<header>
				<Masthead />
				<Hero />
			</header>
			<ProfilePiece />
			<CvAd />
			<RunningHead
				section={sec.works.section}
				name={sec.works.name}
				tagline={sec.works.tagline}
				page={sec.works.page}
				pageNote={sec.works.pageNote}
			/>
			<Plates />
			<RunningHead
				section={sec.columns.section}
				name={sec.columns.name}
				tagline={sec.columns.tagline}
				page={sec.columns.page}
			/>
			<Columns />
			<RunningHead
				section={sec.appointments.section}
				name={sec.appointments.name}
				tagline={sec.appointments.tagline}
				page={sec.appointments.page}
			/>
			<Appointments />
			<RunningHead
				section={sec.correspondence.section}
				name={sec.correspondence.name}
				tagline={sec.correspondence.tagline}
				page={sec.correspondence.page}
			/>
			<Postcard />
			<footer>
				<Classifieds />
				<Finale />
			</footer>
		</Sheet>
		<PageTwo />
	</main>
</Base>

<script>
	import { initCursor } from '../../engine/cursor';
	import { initEdition } from '../../engine/edition';
	import { initEngine } from '../../engine/engine';
	import { initForm } from '../../engine/form';
	import { initIntro } from '../../engine/intro';
	import { initOverlay } from '../../engine/overlay';
	import { initReveals } from '../../engine/reveal';
	import { initTicker } from '../../engine/ticker';

	const engine = initEngine();
	initIntro({ onSettled: () => engine?.measure() });
	initReveals();
	initCursor();
	initEdition();
	initOverlay();
	initForm();
	initTicker();
</script>

<style>
	.progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		z-index: 95;
		background: var(--acc, #b4342a);
		transform-origin: 0 50%;
		transform: scaleX(var(--pg, 0));
	}

	header {
		position: relative;
		padding-top: clamp(0.9rem, 2vw, 1.6rem);
	}

	footer {
		margin-top: clamp(2.6rem, 6vw, 4.4rem);
	}
</style>
