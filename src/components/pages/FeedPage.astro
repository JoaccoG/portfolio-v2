---
import paperTexture from '../../assets/tex/mul-mottle-19.webp';
import { copyFor } from '../../i18n/t';
import Base from '../../layouts/Base.astro';
import CustomCursor from '../CustomCursor.astro';
import Feed from '../columns/Feed.astro';
import Footer from '../columns/Footer.astro';
import Insert from '../columns/Insert.astro';
import Wire from '../columns/Wire.astro';
import PageHead from '../PageHead.astro';
import Sheet from '../paper/Sheet.astro';

const copy = copyFor(Astro.currentLocale);
const f = copy.columns.feed;
const h = copy.columns.head;
const s = copy.sections.columns;
---

<Base
	title={f.docTitle}
	description={f.description}
	preloadImage={paperTexture.src}
>
	<CustomCursor />
	<main id="main-content">
		<Sheet mottleSeed={19}>
			<PageHead
				section={s.section}
				paper={h.paper}
				tagline={s.tagline}
				page={s.page}
				nameplate={h.nameplate}
				headline={f.headline}
				dek={f.dek}
			>
				<Insert />
			</PageHead>
			<Feed />
			<Wire />
			<Footer />
		</Sheet>
	</main>
</Base>

<script>
	import { initCursor } from '../../engine/cursor';
	import { initEdition } from '../../engine/edition';
	import { initEngine } from '../../engine/engine';
	import { initFeed } from '../../engine/feed';
	import { initReveals } from '../../engine/reveal';
	import { initStats } from '../../engine/stats';
	import { initWire } from '../../engine/wire';

	initEngine();
	initReveals();
	initCursor();
	initFeed();
	initWire();
	initEdition();
	initStats();
</script>
