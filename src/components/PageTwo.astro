---
import { getCollection } from 'astro:content';
import { copy } from '../i18n/t';
import PaperTextures from './paper/PaperTextures.astro';

const p = copy.pageTwo;
const series = copy.machinery.title;
const projects = (await getCollection('projects'))
	.filter((project) => project.data.pageTwo)
	.sort((a, b) => a.data.order - b.data.order);
---

{
	projects.map((project) => {
		const d = project.data;
		const pt = d.pageTwo;
		if (!pt) return null;
		const kicker = p.seriesKicker
			.replace('{n}', String(d.order))
			.replace('{series}', series)
			.replace('{year}', String(d.year));
		const readAs = p.readAs.replace('{real}', String(d.year + 100));
		const partYear = `${pt.particulars.year} `;
		const partReadAs = p.readAs.replace(
			'{real}',
			String(pt.particulars.year + 100),
		);
		const [story0 = '', ...storyRest] = pt.story;
		const dropCap = story0.charAt(0);
		const story0Rest = story0.slice(1);
		const storyMid = storyRest.slice(0, -1);
		const storyLast = storyRest[storyRest.length - 1];
		return (
			<div
				class="overlay"
				role="dialog"
				aria-modal="true"
				aria-label={p.ariaLabel.replace('{name}', pt.name)}
				aria-hidden="true"
				inert
				data-page-two={project.id}
			>
				<div class="p2sheet" lang="en">
					<PaperTextures />
					<div class="content">
						<p class="ghost" aria-hidden="true">
							{p.ghost}
						</p>
						<div class="bar">
							<span class="bar-label">{p.header}</span>
							<button type="button" class="return" data-cur="1" data-p2-close>
								{p.return}
							</button>
						</div>
						<p class="kicker">
							{kicker}
							<span class="read-as">{readAs}</span>
						</p>
						<h2 data-p2focus tabindex="-1">{pt.headline}</h2>
						<p class="dek">{pt.dek}</p>
						<p class="byline">{p.byline}</p>
						<figure>
							<div class="fig">
								<span class="chip">{p.chip}</span>
							</div>
							<figcaption>
								{pt.figCaption}
								<span class="cap-it">{pt.figCaptionItalic}</span>
							</figcaption>
						</figure>
						<div class="body">
							<div class="columns">
								<p class="para">
									<span class="drop-cap">{dropCap}</span>
									{story0Rest}
								</p>
								{storyMid.map((para) => (
									<p class="para">{para}</p>
								))}
								<p class="para-last">
									{storyLast}
									<span class="sig">{p.signature}</span>
								</p>
							</div>
							<aside>
								<div class="particulars">
									<p class="part-title">{p.particularsTitle}</p>
									<div class="part-grid">
										<span class="part-label">{p.particularsLabels[0]}</span>
										<span>{pt.particulars.role}</span>
										<span class="part-label">{p.particularsLabels[1]}</span>
										<span>
											{partYear}
											<span class="read-as">{partReadAs}</span>
										</span>
										<span class="part-label">{p.particularsLabels[2]}</span>
										<span>{pt.particulars.composed}</span>
										<span class="part-label">{p.particularsLabels[3]}</span>
										<span class="status">{pt.particulars.status}</span>
									</div>
								</div>
								<blockquote>
									<p class="quote">{pt.quote.text}</p>
									<cite>— {pt.quote.cite}</cite>
								</blockquote>
								<div class="links">
									<a href={pt.links.repo} data-cur="1">
										{p.repoLink}
									</a>
									<a href={pt.links.live} data-cur="1">
										{p.liveLink}
									</a>
								</div>
								{pt.note && <p class="note">{pt.note}</p>}
							</aside>
						</div>
						<div class="foot">
							<span class="foot-label">{p.footer}</span>
							<button type="button" class="return" data-cur="1" data-p2-close>
								{p.return}
							</button>
						</div>
					</div>
				</div>
			</div>
		);
	})
}

<style>
	.overlay {
		position: fixed;
		inset: 0;
		z-index: 80;
		background: rgba(15, 12, 8, 0.78);
		overflow-y: auto;
		overflow-x: hidden;
		opacity: var(--p2o, 0);
		pointer-events: var(--p2p, none);
		transition: opacity 0.5s ease;
		cursor: var(--curCur, auto);
	}

	.p2sheet {
		max-width: 1060px;
		margin: clamp(1rem, 4vh, 3rem) auto;
		background: linear-gradient(
			165deg,
			#f3ecda 0%,
			#f0e6d0 38%,
			#f2ead8 62%,
			#eee3cc 100%
		);
		color: var(--ink, #1c1710);
		position: relative;
		box-shadow: 0 34px 90px rgba(0, 0, 0, 0.65);
		transform: translateY(calc((1 - var(--p2, 0)) * 92vh))
			rotate(calc((1 - var(--p2, 0)) * 3.5deg));
		transition: transform 0.95s cubic-bezier(0.16, 1.08, 0.26, 1);
		transform-origin: 50% 100%;
	}

	.content {
		padding: clamp(1.1rem, 3vw, 2.4rem) clamp(1rem, 4vw, 3rem)
			clamp(2rem, 5vw, 3.2rem);
		position: relative;
		z-index: 4;
		overflow: hidden;
	}

	.ghost {
		position: absolute;
		top: -0.15em;
		right: -0.06em;
		margin: 0;
		font-family: var(--fHD, 'Bodoni Moda'), Didot, serif;
		font-style: italic;
		font-weight: 400;
		font-size: clamp(5rem, 13vw, 10rem);
		line-height: 1;
		opacity: 0.07;
		user-select: none;
		white-space: nowrap;
	}

	.bar {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		border-bottom: 3px double rgba(28, 23, 16, 0.7);
		padding-bottom: 0.5rem;
		gap: 1rem;
		flex-wrap: wrap;
		position: relative;
	}

	.bar-label {
		font-size: 0.64rem;
		letter-spacing: 0.24em;
	}

	.return {
		background: none;
		border: 1px solid var(--ink, #1c1710);
		padding: 0.6rem 1.1rem;
		font-size: 0.6rem;
		letter-spacing: 0.24em;
		cursor: inherit;
		transition:
			background 0.25s ease,
			color 0.25s ease;
	}

	.return:hover {
		background: var(--ink, #1c1710);
		color: var(--paper, #f2ead8);
	}

	.kicker {
		margin: 1.6rem 0 0.6rem;
		font-size: 0.62rem;
		letter-spacing: 0.3em;
		color: var(--acc, #b4342a);
		font-weight: 700;
		position: relative;
	}

	.read-as {
		font-style: italic;
		font-weight: 400;
	}

	h2 {
		margin: 0 0 1rem;
		font-family: var(--fHD, 'Bodoni Moda'), Didot, serif;
		font-weight: 640;
		font-size: clamp(2.2rem, 6vw, 4.6rem);
		line-height: 0.98;
		outline: none;
		text-transform: uppercase;
		text-wrap: balance;
		position: relative;
	}

	.dek {
		margin: 0 0 1.2rem;
		font-style: italic;
		font-size: clamp(1rem, 2vw, 1.3rem);
		line-height: 1.5;
		color: var(--ink-soft, #3a3222);
		position: relative;
	}

	.byline {
		margin: 0 0 1.4rem;
		font-size: 0.64rem;
		letter-spacing: 0.22em;
		border-top: 1px solid rgba(28, 23, 16, 0.4);
		border-bottom: 1px solid rgba(28, 23, 16, 0.4);
		padding: 0.4rem 0;
		position: relative;
	}

	figure {
		margin: 0 0 1.6rem;
		position: relative;
	}

	.fig {
		aspect-ratio: 21 / 9;
		border: 1px solid rgba(28, 23, 16, 0.55);
		box-shadow:
			inset 0 0 0 3px var(--paper, #f2ead8),
			inset 0 0 0 4px rgba(28, 23, 16, 0.55);
		background-color: var(--paper-plate, #e4d8be);
		background-image: radial-gradient(
			rgba(28, 23, 16, 0.5) 1px,
			transparent 1.15px
		);
		background-size: 5px 5px;
		display: grid;
		place-items: center;
	}

	.chip {
		font-size: 0.6rem;
		letter-spacing: 0.2em;
		background: var(--paper, #f2ead8);
		border: 1px solid rgba(28, 23, 16, 0.5);
		padding: 0.5rem 0.8rem;
		text-align: center;
	}

	figcaption {
		text-align: center;
		font-size: 0.66rem;
		letter-spacing: 0.16em;
		padding-top: 0.5rem;
	}

	.cap-it {
		font-style: italic;
		letter-spacing: 0.04em;
	}

	.body {
		display: grid;
		grid-template-columns: var(--gP2, 2fr 1fr);
		gap: clamp(1.4rem, 3vw, 2.6rem);
		position: relative;
	}

	.columns {
		columns: var(--p2Cols, 2);
		column-gap: 2.2rem;
		column-rule: 1px solid rgba(28, 23, 16, 0.2);
		font-size: 0.95rem;
		line-height: 1.65;
		text-align: justify;
		hyphens: manual;
	}

	.para {
		margin: 0 0 0.9rem;
	}

	.para-last {
		margin: 0;
	}

	.sig {
		letter-spacing: 0.12em;
	}

	.drop-cap {
		float: left;
		font-family: var(--fHD, 'Bodoni Moda'), Didot, serif;
		font-size: 3.2em;
		line-height: 0.76;
		padding: 0.05em 0.12em 0 0;
		font-weight: 600;
	}

	aside {
		border-left: var(--colB, 1px solid rgba(28, 23, 16, 0.25));
		padding-left: var(--colPad, clamp(1.2rem, 2.4vw, 2rem));
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
	}

	.particulars {
		border: 3px double rgba(28, 23, 16, 0.65);
		padding: 0.9rem 1rem;
	}

	.part-title {
		margin: 0 0 0.6rem;
		text-align: center;
		font-size: 0.62rem;
		letter-spacing: 0.28em;
		font-weight: 700;
	}

	.part-grid {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.45rem 0.8rem;
		font-size: 0.74rem;
		letter-spacing: 0.08em;
	}

	.part-label {
		font-weight: 700;
	}

	.status {
		color: var(--acc, #b4342a);
	}

	blockquote {
		margin: 0;
		border-top: 1px solid rgba(28, 23, 16, 0.5);
		border-bottom: 1px solid rgba(28, 23, 16, 0.5);
		padding: 1rem 0.2rem;
		text-align: center;
	}

	.quote {
		margin: 0;
		font-family: var(--fHD, 'Bodoni Moda'), Didot, serif;
		font-style: italic;
		font-size: 1.3rem;
		line-height: 1.35;
	}

	cite {
		display: block;
		margin-top: 0.5rem;
		font-size: 0.6rem;
		letter-spacing: 0.24em;
		font-style: normal;
	}

	.links {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.links a {
		border: 1px solid var(--ink, #1c1710);
		padding: 0.75rem 1rem;
		font-size: 0.64rem;
		letter-spacing: 0.24em;
		text-align: center;
		transition:
			background 0.25s ease,
			color 0.25s ease;
	}

	.links a:hover {
		background: var(--ink, #1c1710);
		color: var(--paper, #f2ead8);
	}

	.note {
		margin: 0;
		font-size: 0.56rem;
		letter-spacing: 0.2em;
		opacity: 0.6;
		text-align: center;
	}

	.foot {
		margin-top: clamp(1.6rem, 4vw, 2.6rem);
		border-top: 3px double rgba(28, 23, 16, 0.7);
		padding-top: 1rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		position: relative;
	}

	.foot .return {
		padding: 0.75rem 1.3rem;
		font-size: 0.64rem;
	}

	.foot-label {
		font-size: 0.6rem;
		letter-spacing: 0.24em;
		font-style: italic;
	}

	@media (min-width: 768px) and (max-width: 1059.98px) {
		.p2sheet {
			max-width: calc(100% - 3.5rem);
		}
	}

	@media (max-width: 767.98px) {
		.p2sheet {
			max-width: none;
			margin: 9vh 0 0;
			min-height: 91vh;
			border-radius: 20px 20px 0 0;
			overflow: hidden;
			box-shadow: 0 -14px 44px rgba(0, 0, 0, 0.55);
			transform: translateY(calc((1 - var(--p2, 0)) * 100%));
		}

		.p2sheet::before {
			content: '';
			position: absolute;
			top: 0.65rem;
			left: 50%;
			transform: translateX(-50%);
			width: 2.6rem;
			height: 0.3rem;
			border-radius: 999px;
			background: rgba(28, 23, 16, 0.28);
			z-index: 6;
		}

		.content {
			padding-top: 1.9rem;
		}
	}
</style>
