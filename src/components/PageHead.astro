---
import RunningHead from './RunningHead.astro';

interface Props {
	section: string;
	paper: string;
	tagline: string;
	page: string;
	nameplate: string;
	headline: string;
	dek?: string;
	titleTag?: 'h1' | 'p';
}

const {
	section,
	paper,
	tagline,
	page,
	nameplate,
	headline,
	dek,
	titleTag = 'h1',
} = Astro.props;

const Title = titleTag;
---

<RunningHead section={section} name={paper} tagline={tagline} page={page} flush />

<slot />

<header class="head">
	<p class="plate">
		<span class="fleuron" aria-hidden="true">✦</span><a
			href="/"
			class="nameplate"
			data-cur="1">{nameplate}</a
		><span class="fleuron" aria-hidden="true">✦</span>
	</p>
	<Title class="headline">{headline}<span class="acc">.</span></Title>
	{dek && <p class="dek">{dek}</p>}
</header>

<style>
	@keyframes riseIn {
		from {
			transform: translateY(26px);
			opacity: 0;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}

	.head {
		text-align: center;
		padding: clamp(1.4rem, 3.2vw, 2.6rem) 0 clamp(1rem, 2.4vw, 1.8rem);
		border-bottom: 3px double rgba(28, 23, 16, 0.75);
	}

	.plate {
		margin: 0;
		font-size: clamp(1.25rem, 2.2vw, 1.95rem);
		display: flex;
		align-items: center;
		justify-content: center;
		animation: riseIn 0.7s cubic-bezier(0.19, 1, 0.22, 1) 0.05s both;
	}

	.fleuron {
		color: var(--acc, #b4342a);
		font-size: 0.42em;
		line-height: 1;
	}

	.fleuron:first-child {
		margin-right: 0.55em;
	}

	.fleuron:last-child {
		margin-left: 0.55em;
	}

	.nameplate {
		display: inline-block;
		font-family: var(--fNP, "UnifrakturMaguntia"), "Bodoni MT", Didot, serif;
		font-size: 1em;
		line-height: 1;
		letter-spacing: 0.01em;
	}


	.headline {
		margin: 0.35rem 0 0;
		animation: riseIn 0.9s cubic-bezier(0.19, 1, 0.22, 1) 0.24s both;
		font-family: var(--fHD, "Abril Fatface"), Didot, serif;
		font-weight: 400;
		font-size: clamp(2.1rem, 4.8vw, 4.4rem);
		line-height: 0.95;
		text-transform: uppercase;
		letter-spacing: -0.005em;
	}

	.acc {
		color: var(--acc, #b4342a);
	}

	.dek {
		margin: 0.7rem auto 0;
		max-width: 40rem;
		font-style: italic;
		font-size: clamp(0.92rem, 1.6vw, 1.1rem);
		line-height: 1.5;
		color: var(--ink-soft, #3a3222);
		text-wrap: pretty;
		animation: riseIn 0.9s cubic-bezier(0.19, 1, 0.22, 1) 0.4s both;
	}


	@media (max-width: 719.98px) {
		.paper {
			display: none;
		}
	}

	@media (max-width: 559.98px) {
		.page {
			display: none;
		}
	}
</style>
