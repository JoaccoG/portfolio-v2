---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { copy } from '../i18n/t';

const m = copy.machinery;
const romans = [
	'I',
	'II',
	'III',
	'IV',
	'V',
	'VI',
	'VII',
	'VIII',
	'IX',
	'X',
	'XI',
	'XII',
];
const projects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order,
);
const countWord = m.numberWords[projects.length] ?? String(projects.length);
const subtitle = (
	projects.length === 1 ? m.subtitleSingular : m.subtitle
).replace('{count}', countWord);
const plateKicker = (i: number, label: string, year: number) =>
	m.plateKicker
		.replace('{n}', String(i + 1))
		.replace('{label}', label)
		.replace('{year}', String(year));
const plateLabel = (i: number) => m.plateLabel.replace('{roman}', romans[i]);
const coverWidths = [420, 640, 780, 1120];
const coverSizes = '(max-width: 767.98px) 92vw, 44vw';
---

<section id="works" data-goto="works">
	<div class="head" data-rv="1">
		<p class="head-kicker">{m.kicker}</p>
		<h2>{m.title}<span class="acc">.</span></h2>
		<p class="head-sub">{subtitle}</p>
	</div>
	{
		projects.map((project, i) => {
			const imageLeft = i % 2 === 0;
			const cover = project.data.cover;
			const image = (
				<div class="plate-img">
					<div class="clip">
						<div
							class="pframe"
							style={cover && `--plateAR:${cover.src.width}/${cover.src.height}`}
						>
							<div class="halftone">
								{cover ? (
									<Image
										class="cover"
										src={cover.src}
										alt={cover.alt}
										widths={coverWidths}
										sizes={coverSizes}
									/>
								) : (
									<span class="chip">{m.chip}</span>
								)}
							</div>
							{project.data.stamp && (
								<span class="stamp" aria-hidden="true">
									<span class="stamp-line">{project.data.stamp.line}</span>
									<span class="stamp-sub">{project.data.stamp.sub}</span>
								</span>
							)}
						</div>
					</div>
					<span class:list={['label', imageLeft ? 'label-l' : 'label-r']}>
						{plateLabel(i)}
					</span>
				</div>
			);
			const text = (
				<div class:list={[{ 'text-swap': !imageLeft }]}>
					<p class:list={['meta-kicker', { 'kicker-acc': project.data.pageTwo }]}>
						{plateKicker(i, project.data.kickerLabel, project.data.year)}
					</p>
					<h3>
						{project.data.titleLines.map((line, li) => (
							<span class:list={['tmask', `tm-${li + 1}`]}>
								<span class:list={['tline', `tl-${li + 1}`]}>{line}</span>
							</span>
						))}
					</h3>
					<p class="dek">{project.data.dek}</p>
					<p class="composed">{project.data.composedWith}</p>
					{project.data.pageTwo ? (
						<button
							type="button"
							class="full-account"
							data-cur="1"
							data-page-open={project.id}
							aria-label={m.fullAccountAria.replace(
								'{title}',
								project.data.titleLines.join(' '),
							)}
						>
							<span class="acc" aria-hidden="true">☞</span> {m.fullAccount}
						</button>
					) : (
						<p class="follow">{m.accountFollow}</p>
					)}
				</div>
			);
			const body = imageLeft ? (
				<>
					{image}
					{text}
				</>
			) : (
				<>
					{text}
					{image}
				</>
			);
			return (
				<article data-rv="1" data-plate="1" class:list={[{ last: i === projects.length - 1 }]}>
					<div class:list={['row', { 'row-swap': !imageLeft }]}>{body}</div>
				</article>
			);
		})
	}
</section>

<style>
	section {
		padding-top: clamp(2.4rem, 6vw, 4rem);
	}

	.head {
		text-align: center;
		opacity: var(--rv, 1);
		transform: translateY(calc((1 - var(--rv, 1)) * 22px));
		transition:
			opacity 0.9s ease,
			transform 0.9s cubic-bezier(0.19, 1, 0.22, 1);
	}

	.head-kicker {
		margin: 0 0 0.5rem;
		font-size: 0.64rem;
		letter-spacing: 0.3em;
		color: var(--acc, #b4342a);
		font-weight: 700;
	}

	h2 {
		margin: 0;
		font-family: var(--fHD, 'Bodoni Moda'), Didot, serif;
		font-weight: 620;
		font-size: clamp(2.2rem, 6vw, 4.8rem);
		line-height: 1;
		text-transform: uppercase;
	}

	.acc {
		color: var(--acc, #b4342a);
	}

	.head-sub {
		margin: 0.7rem 0 0;
		font-size: 0.66rem;
		letter-spacing: 0.24em;
		font-style: italic;
	}

	article {
		position: relative;
		margin-top: 0;
		border-top: 1px solid rgba(28, 23, 16, 0.4);
		opacity: var(--rv, 1);
		transition: opacity 0.9s ease;
	}

	article:first-of-type {
		margin-top: clamp(2rem, 4.6vw, 3.2rem);
	}

	article.last {
		border-bottom: 1px solid rgba(28, 23, 16, 0.4);
	}

	.row {
		display: grid;
		grid-template-columns: var(--gRow, 1.05fr 1fr);
		gap: clamp(1.4rem, 3.4vw, 3rem);
		align-items: center;
		width: 100%;
		background: none;
		border: none;
		padding: clamp(1.6rem, 3.6vw, 2.6rem) 0;
		text-align: left;
		cursor: inherit;
		color: var(--ink, #1c1710);
	}

	.row-swap {
		grid-template-columns: var(--gRow, 1fr 1.05fr);
	}

	.text-swap {
		order: var(--rowSwap, 0);
	}

	.plate-img {
		position: relative;
	}

	.clip {
		clip-path: inset(calc((1 - var(--rv, 1)) * 12%) calc((1 - var(--rv, 1)) * 9%));
		transition: clip-path 1.2s cubic-bezier(0.19, 1, 0.22, 1) 0.1s;
	}

	.pframe {
		position: relative;
		aspect-ratio: var(--plateAR, 16 / 10);
		border: 1px solid rgba(28, 23, 16, 0.55);
		box-shadow:
			inset 0 0 0 3px var(--paper, #f2ead8),
			inset 0 0 0 4px rgba(28, 23, 16, 0.55);
		overflow: hidden;
	}

	.halftone {
		width: 100%;
		height: 100%;
		background-color: var(--paper-plate, #e4d8be);
		background-image: radial-gradient(
			rgba(28, 23, 16, 0.5) 1px,
			transparent 1.15px
		);
		background-size: 5px 5px;
		display: grid;
		place-items: center;
	}

	article:hover,
	article:has(:focus-visible) {
		--u: 1;
	}

	.cover {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: sepia(0.08) contrast(1.02);
	}

	.chip {
		font-size: 0.6rem;
		letter-spacing: 0.2em;
		background: var(--paper, #f2ead8);
		border: 1px solid rgba(28, 23, 16, 0.5);
		padding: 0.5rem 0.8rem;
	}

	.stamp {
		position: absolute;
		right: 6%;
		bottom: 8%;
		z-index: 2;
		pointer-events: none;
		border: 3px solid var(--paper, #f2ead8);
		color: var(--paper, #f2ead8);
		padding: 0.6rem 1.15rem 0.5rem;
		text-align: center;
		opacity: 0.88;
		transform: rotate(-6deg);
		backdrop-filter: blur(8px);
	}

	.stamp::before {
		content: '';
		position: absolute;
		inset: 4px;
		border: 1px solid rgba(242, 234, 216, 0.55);
	}

	.stamp-line {
		display: block;
		font-family: var(--fHD, 'Abril Fatface'), Didot, serif;
		font-size: clamp(0.78rem, 1.7vw, 1.2rem);
		letter-spacing: 0.07em;
		line-height: 1;
		white-space: nowrap;
	}

	.stamp-sub {
		display: block;
		border-top: 1px solid rgba(242, 234, 216, 0.6);
		margin-top: 0.34rem;
		padding-top: 0.28rem;
		font-size: clamp(0.44rem, 0.85vw, 0.54rem);
		letter-spacing: 0.22em;
		white-space: nowrap;
	}

	.label {
		position: absolute;
		top: -0.6rem;
		background: color-mix(
			in oklab,
			var(--ink, #1c1710) calc((1 - var(--u, 0)) * 100%),
			var(--acc, #b4342a) calc(var(--u, 0) * 100%)
		);
		transition: background 0.5s ease;
		color: var(--paper, #f2ead8);
		font-size: 0.56rem;
		letter-spacing: 0.24em;
		padding: 0.35rem 0.7rem;
	}

	.label-l {
		left: 1rem;
	}

	.label-r {
		right: 1rem;
	}

	.meta-kicker {
		margin: 0 0 0.6rem;
		font-size: 0.62rem;
		letter-spacing: 0.3em;
		font-weight: 700;
	}

	.kicker-acc {
		color: var(--acc, #b4342a);
	}

	h3 {
		margin: 0 0 0.8rem;
		font-family: var(--fHD, 'Bodoni Moda'), Didot, serif;
		font-weight: 640;
		font-size: clamp(1.9rem, 4.4vw, 3.6rem);
		line-height: 0.98;
		text-transform: uppercase;
	}

	.tmask {
		display: block;
		overflow: hidden;
	}

	.tm-1 {
		padding-bottom: 0.04em;
	}

	.tm-2 {
		padding-bottom: 0.06em;
	}

	.tline {
		display: inline-block;
		background-image: linear-gradient(
			var(--acc, #b4342a),
			var(--acc, #b4342a)
		);
		background-repeat: no-repeat;
		background-position: 0 94%;
		background-size: calc(var(--u, 0) * 100%) 4px;
		transform: translateY(calc((1 - var(--rv, 1)) * 110%));
	}

	.tl-1 {
		transition:
			transform 0.9s cubic-bezier(0.19, 1, 0.22, 1) 0.15s,
			background-size 0.5s cubic-bezier(0.19, 1, 0.22, 1);
	}

	.tl-2 {
		transition:
			transform 0.9s cubic-bezier(0.19, 1, 0.22, 1) 0.25s,
			background-size 0.5s cubic-bezier(0.19, 1, 0.22, 1) 0.45s;
	}

	.dek {
		margin: 0 0 0.9rem;
		font-style: italic;
		font-size: clamp(0.95rem, 1.7vw, 1.15rem);
		line-height: 1.55;
		color: var(--ink-soft, #3a3222);
	}

	.composed {
		margin: 0 0 1rem;
		font-size: 0.62rem;
		letter-spacing: 0.2em;
	}

	.full-account {
		margin: 0;
		display: inline-block;
		background: none;
		border: 1px solid var(--ink, #1c1710);
		padding: 0.75rem 1.2rem;
		text-align: center;
		cursor: inherit;
		color: var(--ink, #1c1710);
		font-size: 0.64rem;
		letter-spacing: 0.24em;
		transition:
			background 0.25s ease,
			color 0.25s ease;
	}

	.full-account:hover {
		background: var(--ink, #1c1710);
		color: var(--paper, #f2ead8);
	}

	.full-account .acc {
		transition: color 0.25s ease;
	}

	.full-account:hover .acc {
		color: inherit;
	}

	.full-account::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.follow {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		font-style: italic;
		opacity: 0.65;
	}
</style>
