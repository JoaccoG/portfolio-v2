---
import Hero from '../components/Hero.astro';
import Masthead from '../components/Masthead.astro';
import ProfilePiece from '../components/ProfilePiece.astro';
import Sheet from '../components/paper/Sheet.astro';
import Ticker from '../components/Ticker.astro';
import Base from '../layouts/Base.astro';
---

<Base>
	<main>
		<Sheet>
			<Ticker />
			<header>
				<Masthead />
				<Hero />
			</header>
			<ProfilePiece />
			<div class="placeholder"></div>
		</Sheet>
	</main>
</Base>

<style>
	header {
		position: relative;
		padding-top: clamp(0.9rem, 2vw, 1.6rem);
	}

	.placeholder {
		min-height: 100vh;
	}
</style>
