---
import Appointments from '../components/Appointments.astro';
import Classifieds from '../components/Classifieds.astro';
import Columns from '../components/Columns.astro';
import CustomCursor from '../components/CustomCursor.astro';
import CvAd from '../components/CvAd.astro';
import Finale from '../components/Finale.astro';
import Hero from '../components/Hero.astro';
import Masthead from '../components/Masthead.astro';
import PageTwo from '../components/PageTwo.astro';
import Plates from '../components/Plates.astro';
import Postcard from '../components/Postcard.astro';
import Preloader from '../components/Preloader.astro';
import ProfilePiece from '../components/ProfilePiece.astro';
import Sheet from '../components/paper/Sheet.astro';
import RunningHead from '../components/RunningHead.astro';
import Ticker from '../components/Ticker.astro';
import { copy } from '../i18n/t';
import Base from '../layouts/Base.astro';

const sec = copy.sections;
---

<Base>
	<script is:inline>
		(() => {
			const doc = document.documentElement;
			let seen = false;
			try {
				seen = sessionStorage.getItem('hasSeenIntro') === '1';
			} catch (e) {
				seen = false;
			}
			if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			doc.dataset.intro = 'play';
			const style = doc.style;
			style.setProperty('--preO', '1');
			style.setProperty('--prePE', 'auto');
			style.setProperty('--intro', '0');
			style.setProperty('--mh', '0');
			style.overflow = 'hidden';
			try {
				sessionStorage.setItem('hasSeenIntro', '1');
			} catch (e) {}
		})();
	</script>
	<span class="progress" data-progress aria-hidden="true"></span>
	<Preloader />
	<CustomCursor />
	<main id="main-content">
		<Sheet>
			<Ticker />
			<header>
				<Masthead />
				<Hero />
			</header>
			<RunningHead
				section={sec.profile.section}
				name={sec.profile.name}
				tagline={sec.profile.tagline}
				page={sec.profile.page}
			/>
			<ProfilePiece />
			<CvAd />
			<RunningHead
				section={sec.works.section}
				name={sec.works.name}
				tagline={sec.works.tagline}
				page={sec.works.page}
			/>
			<Plates />
			<RunningHead
				section={sec.columns.section}
				name={sec.columns.name}
				tagline={sec.columns.tagline}
				page={sec.columns.page}
			/>
			<Columns />
			<RunningHead
				section={sec.appointments.section}
				name={sec.appointments.name}
				tagline={sec.appointments.tagline}
				page={sec.appointments.page}
			/>
			<Appointments />
			<RunningHead
				section={sec.correspondence.section}
				name={sec.correspondence.name}
				tagline={sec.correspondence.tagline}
				page={sec.correspondence.page}
			/>
			<Postcard />
			<footer>
				<Classifieds />
				<Finale />
			</footer>
		</Sheet>
		<PageTwo />
	</main>
</Base>

<script>
	import { initCursor } from '../engine/cursor';
	import { initEngine } from '../engine/engine';
	import { initForm } from '../engine/form';
	import { initIntro } from '../engine/intro';
	import { initMusic } from '../engine/music';
	import { initNativeEngine } from '../engine/native';
	import { initOverlay } from '../engine/overlay';
	import { initReveals } from '../engine/reveal';
	import { initTicker } from '../engine/ticker';

	const engine = matchMedia('(pointer: coarse)').matches
		? initNativeEngine()
		: initEngine();
	initIntro({ onSettled: () => engine?.measure() });
	initReveals();
	initCursor();
	initMusic();
	initOverlay();
	initForm();
	initTicker();
</script>

<style>
	.progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		z-index: 95;
		background: var(--acc, #b4342a);
		transform-origin: 0 50%;
		transform: scaleX(var(--pg, 0));
	}

	header {
		position: relative;
		padding-top: clamp(0.9rem, 2vw, 1.6rem);
	}

	footer {
		margin-top: clamp(2.6rem, 6vw, 4.4rem);
	}
</style>
