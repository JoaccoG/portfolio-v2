---
import Appointments from '../components/Appointments.astro';
import Classifieds from '../components/Classifieds.astro';
import CvAd from '../components/CvAd.astro';
import Finale from '../components/Finale.astro';
import Hero from '../components/Hero.astro';
import Masthead from '../components/Masthead.astro';
import PageTwo from '../components/PageTwo.astro';
import Plates from '../components/Plates.astro';
import Postcard from '../components/Postcard.astro';
import ProfilePiece from '../components/ProfilePiece.astro';
import Sheet from '../components/paper/Sheet.astro';
import Ticker from '../components/Ticker.astro';
import Base from '../layouts/Base.astro';
---

<Base>
	<main>
		<Sheet>
			<Ticker />
			<header>
				<Masthead />
				<Hero />
			</header>
			<ProfilePiece />
			<CvAd />
			<Plates />
			<Appointments />
			<Postcard />
			<footer>
				<Classifieds />
				<Finale />
			</footer>
		</Sheet>
		<PageTwo />
	</main>
</Base>

<style>
	header {
		position: relative;
		padding-top: clamp(0.9rem, 2vw, 1.6rem);
	}

	footer {
		margin-top: clamp(2.6rem, 6vw, 4.4rem);
	}
</style>
