---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/breakpoints.css';
import '../styles/global.css';
import { copy } from '../i18n/t';

interface Props {
	title?: string;
	description?: string;
}

const { title = copy.meta.title, description = copy.meta.description } =
	Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site ? new URL('/og.jpg', site).href : undefined;
const person = copy.meta.person;
const personLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: person.name,
	jobTitle: person.jobTitle,
	email: 'mailto:joaquingodoy2407@gmail.com',
	address: {
		'@type': 'PostalAddress',
		addressLocality: person.locality,
		addressCountry: person.country,
	},
	sameAs: [
		'https://github.com/JoaccoG',
		'https://www.linkedin.com/in/joaquin--godoy/',
	],
	...(site ? { url: site.href } : {}),
};
const siteLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: copy.meta.siteName,
	...(site ? { url: site.href } : {}),
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0f0c08" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={copy.meta.siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="en_US" />
		{canonical && <meta property="og:url" content={canonical} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		{ogImage && <meta property="og:image:width" content="1200" />}
		{ogImage && <meta property="og:image:height" content="630" />}
		{ogImage && <meta property="og:image:alt" content={title} />}
		<meta
			name="twitter:card"
			content={ogImage ? 'summary_large_image' : 'summary'}
		/>
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}
		{ogImage && <meta name="twitter:image:alt" content={title} />}
		<link
			rel="preload"
			href="/fonts/unifrakturmaguntia-400.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/abril-fatface-400.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/old-standard-tt-400.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/old-standard-tt-400-italic.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/old-standard-tt-700.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">{copy.meta.skipToContent}</a>
		<slot />
	</body>
</html>

<style>
	.skip-link {
		position: fixed;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 200;
		transform: translateY(-160%);
		background: var(--ink, #1c1710);
		color: var(--paper, #f2ead8);
		padding: 0.7rem 1.1rem;
		font-family: var(--fBD, 'Old Standard TT'), serif;
		font-size: 0.7rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		text-decoration: none;
		transition: transform 0.2s ease;
	}

	.skip-link:focus {
		transform: translateY(0);
	}
</style>
